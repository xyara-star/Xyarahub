-- Tombol Unlock
local unlockBtn = Instance.new("TextButton")
unlockBtn.Size = UDim2.new(0, 88, 0, 36)
unlockBtn.Position = UDim2.new(1, -96, 0, 52)
unlockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
unlockBtn.Text = "UNLOCK"
unlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
unlockBtn.Font = Enum.Font.GothamBold
unlockBtn.TextSize = 13
unlockBtn.Parent = frame

local unlockCorner = Instance.new("UICorner")
unlockCorner.CornerRadius = UDim.new(0, 6)
unlockCorner.Parent = unlockBtn

-- ===== LOGIKA =====

local function setStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

-- Coba equip tool terkunci kalau sedang tidak di tangan
local function tryEquip()
    if not isLocked or not lockedTool then return end
    if not lockedTool.Parent then return end -- tool sudah dihapus / terjual

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if lockedTool.Parent == char then return end -- sudah di tangan
    pcall(function()
        hum:EquipTool(lockedTool)
    end)
end

-- Pasang listener di tool terkunci
local function hookTool(tool)
    if not tool then return end

    -- Listener utama: begitu tool dilepas, langsung re-equip (tanpa delay)
    addConn(tool.Unequipped:Connect(function()
        if isLocked and lockedTool == tool then
            task.defer(tryEquip)
        end
    end))

    -- Kalau tool dihapus dari game (terjual / hancur), matikan lock
    addConn(tool.AncestryChanged:Connect(function()
        if isLocked and lockedTool == tool and not tool.Parent then
            isLocked = false
            lockedTool = nil
            clearConns()
            setStatus("Status: Item hilang, unlock", Color3.fromRGB(255, 180, 80))
        end
    end))
end

-- Hook karakter (untuk respawn)
local function hookCharacter(char)
    if not char then return end

    -- Pantau kalau tool terkunci entah kenapa pindah keluar dari character
    addConn(char.ChildRemoved:Connect(function(child)
        if isLocked and child == lockedTool then
            task.defer(tryEquip)
        end
    end))
end

-- ===== TOMBOL LOCK =====
lockBtn.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        setStatus("Pegang item dulu!", Color3.fromRGB(255, 180, 80))
        return
    end

    -- Reset koneksi lama
    clearConns()

    isLocked = true
    lockedTool = tool

    hookTool(tool)
    hookCharacter(char)

    setStatus("Locked: " .. tool.Name, Color3.fromRGB(0, 220, 120))

    -- Paksa langsung di tangan (jaga-jaga)
    tryEquip()
end)

-- ===== TOMBOL UNLOCK =====
unlockBtn.MouseButton1Click:Connect(function()
    isLocked = false
    lockedTool = nil
    clearConns()
    setStatus("Status: Unlocked", Color3.fromRGB(255, 255, 255))
end)

-- ===== AUTO RE-HOOK SAAT RESPAWN =====
player.CharacterAdded:Connect(function(newChar)
    task.wait(0.5) -- tunggu tool masuk ke backpack
    if not isLocked or not lockedTool then return end

    -- Tool biasanya dikembalikan ke backpack saat respawn
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack and lockedTool.Parent == backpack then
        local hum = newChar:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:EquipTool(lockedTool)
            end)
        end
    end

    hookCharacter(newChar)
end)

-- ===== INIT =====
setStatus("Status: Unlocked")
print("[Tool Lock Pro v2] Loaded")
