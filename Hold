--[[
    Tool Lock Pro v6
    - Toggle ON/OFF (saklar fitur utama)
    - Tombol LOCK (kunci item yang sedang dipegang)
    - Tombol UNLOCK (lepas kunci)
    - 0 delay saat lock
    - Auto-unlock kalau item terjual/hilang
    - Destroy UI = matikan semua
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local old = CoreGui:FindFirstChild("SimpleToolLock")
if old then old:Destroy() end

-- ===== STATE =====
local featureOn = false    -- toggle ON/OFF
local isLocked = false     -- status lock item
local lockedTool = nil
local conns = {}
local isDestroyed = false

local function clearConns()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
end
local function addConn(c) if c then table.insert(conns, c) end end

