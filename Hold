-- ===== HELPER =====
local function setStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(200, 200, 220)
end

local function autoUnlock(reason)
    isLocked = false
    lockedTool = nil
    clearConns()
    setStatus(reason or "Item hilang → unlock otomatis", Color3.fromRGB(255, 180, 80))
end

local function forceEquip()
    if isDestroyed or not featureOn or not isLocked or not lockedTool then return end
    if not lockedTool.Parent then
        autoUnlock("Item terjual/hilang → unlock")
        return
    end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if lockedTool.Parent == char then return end
    pcall(function() hum:EquipTool(lockedTool) end)
end

local function hookTool(tool)
    addConn(tool.Unequipped:Connect(function()
        if featureOn and isLocked and lockedTool == tool then forceEquip() end
    end))
    addConn(tool.AncestryChanged:Connect(function()
        if isLocked and lockedTool == tool and not tool.Parent then
            autoUnlock("Item terjual/hilang → unlock")
        end
    end))
end

local function hookCharacter(char)
    addConn(char.ChildRemoved:Connect(function(child)
        if featureOn and isLocked and child == lockedTool then forceEquip() end
    end))
end

-- Loop cek 0 delay
local holdConn = RunService.RenderStepped:Connect(function()
    if isDestroyed or not featureOn or not isLocked or not lockedTool then return end
    if not lockedTool.Parent then
        autoUnlock("Item terjual/hilang → unlock")
        return
    end
    local char = player.Character
    if not char then return end
    if lockedTool.Parent ~= char then forceEquip() end
end)

-- ===== TOGGLE ON/OFF =====
toggleSwitch.MouseButton1Click:Connect(function()
    if isDestroyed then return end
    featureOn = not featureOn

    if featureOn then
        toggleSwitch.Text = "ON"
        toggleSwitch.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
        toggleLabel.Text = "FITUR: ON"
        toggleLabel.TextColor3 = Color3.fromRGB(0, 255, 140)
    else
        toggleSwitch.Text = "OFF"
        toggleSwitch.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
        toggleLabel.Text = "FITUR: OFF"
        toggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        -- Matikan lock juga saat fitur OFF
        isLocked = false
        lockedTool = nil
        clearConns()
        setStatus("Fitur OFF", Color3.fromRGB(200, 200, 220))
    end
end)

-- ===== TOMBOL LOCK =====
lockBtn.MouseButton1Click:Connect(function()
    if isDestroyed then return end
    if not featureOn then
        setStatus("Nyalakan FITUR dulu (toggle ON)", Color3.fromRGB(255, 180, 80))
        return
    end
    if isLocked then
        setStatus("Sudah ada item terkunci: " .. (lockedTool and lockedTool.Name or "?"), Color3.fromRGB(255, 180, 80))
        return
    end

    local char = player.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        setStatus("Pegang item dulu baru LOCK", Color3.fromRGB(255, 180, 80))
        return
    end

    clearConns()
    isLocked = true
    lockedTool = tool
    hookTool(tool)
    hookCharacter(char)
    setStatus("Terkunci: " .. tool.Name, Color3.fromRGB(0, 220, 120))
end)

-- ===== TOMBOL UNLOCK =====
unlockBtn.MouseButton1Click:Connect(function()
    if isDestroyed then return end
    if not isLocked then
        setStatus("Tidak ada item yang dikunci", Color3.fromRGB(200, 200, 220))
        return
    end
    isLocked = false
    lockedTool = nil
    clearConns()
    setStatus("Item dilepas dari lock", Color3.fromRGB(255, 255, 255))
end)

-- ===== DESTROY =====
destroyBtn.MouseButton1Click:Connect(function()
    isDestroyed = true
    featureOn = false
    isLocked = false
    lockedTool = nil
    clearConns()
    if holdConn then holdConn:Disconnect() end
    pcall(function() gui:Destroy() end)
    print("[Tool Lock Pro v6] Destroyed")
end)

-- Respawn
player.CharacterAdded:Connect(function(newChar)
    task.wait(0.3)
    if isDestroyed or not featureOn or not isLocked or not lockedTool then return end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack and lockedTool.Parent == backpack then
        local hum = newChar:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum:EquipTool(lockedTool) end) end
    end
    hookCharacter(newChar)
end)

print("[Tool Lock Pro v6] Loaded")
