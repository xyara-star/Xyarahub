-- ===== LOGIKA PENGUNCIAN UTAMA =====
local lockedToolName = nil
local isLocked = false
local connections = {}

local function clearConnections()
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	connections = {}
end

local function forceEquip()
	if not isLocked or not lockedToolName then return end
	
	task.delay(0.5, function() -- Jeda 0.5 detik untuk memberi waktu game selesai proses jual/reset
		if not isLocked then return end
		local char = player.Character
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		-- Cek apakah sudah di tangan
		if char:FindFirstChild(lockedToolName) then return end
		
		-- Cari di backpack
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			local tool = backpack:FindFirstChild(lockedToolName)
			if tool and tool:IsA("Tool") then
				pcall(function()
					humanoid:EquipTool(tool)
				end)
			end
		end
	end)
end

local function hookCharacter(char)
	-- Pantau jika tool dilepas dari tangan
	local childRemovedConn = char.ChildRemoved:Connect(function(child)
		if isLocked and child.Name == lockedToolName and child:IsA("Tool") then
			forceEquip()
		end
	end)
	table.insert(connections, childRemovedConn)
end

-- Tombol LOCK
lockBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end
	
	local currentTool = char:FindFirstChildOfClass("Tool")
	if not currentTool then
		statusLabel.Text = "Pegang item dulu!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
		return
	end
	
	lockedToolName = currentTool.Name
	isLocked = true
	statusLabel.Text = "Locked: " .. lockedToolName
	statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
	
	clearConnections()
	hookCharacter(char)
	
	-- Pantau jika karakter respawn/mati
	local charAddedConn = player.CharacterAdded:Connect(function(newChar)
		hookCharacter(newChar)
		forceEquip()
	end)
	table.insert(connections, charAddedConn)
	
	-- Pantau juga jika item masuk kembali ke backpack (setelah transaksi sell)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		local bpConn = backpack.ChildAdded:Connect(function(child)
			if isLocked and child.Name == lockedToolName then
				forceEquip()
			end
		end)
		table.insert(connections, bpConn)
	end
end)

-- Tombol UNLOCK
unlockBtn.MouseButton1Click:Connect(function()
	isLocked = false
	lockedToolName = nil
	clearConnections()
	statusLabel.Text = "Status: Unlocked"
	statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end)
