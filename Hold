--[[
    Tool Lock Pro v2 - Fixed
    - Listener Unequipped (tanpa delay)
    - Simpan referensi tool, bukan nama
    - Auto re-hook saat respawn
    - Deteksi tool hilang / dijual
    - Toggle ON/OFF
]]

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- ===== HAPUS GUI LAMA =====
local old = CoreGui:FindFirstChild("SimpleToolLock")
if old then old:Destroy() end

-- ===== STATE =====
local isLocked = false
local lockedTool = nil
local conns = {}

local function clearConns()
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
end

local function addConn(c)
    if c then table.insert(conns, c) end
end

-- ===== UI =====
local gui = Instance.new("ScreenGui")
gui.Name = "SimpleToolLock"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 120)
frame.Position = UDim2.new(0, 30, 0.5, -60)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(70, 70, 90)
stroke.Thickness = 2
stroke.Parent = frame

-- Status
local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -16, 0, 34)
statusLabel.Position = UDim2.new(0, 8, 0, 8)
statusLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
statusLabel.Text = "Status: Unlocked"
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextSize = 12
statusLabel.TextWrapped = true
statusLabel.Parent = frame

local labelCorner = Instance.new("UICorner")
labelCorner.CornerRadius = UDim.new(0, 6)
labelCorner.Parent = statusLabel

-- Tombol Lock
local lockBtn = Instance.new("TextButton")
lockBtn.Size = UDim2.new(0, 88, 0, 36)
lockBtn.Position = UDim2.new(0, 8, 0, 52)
lockBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
lockBtn.Text = "LOCK"
