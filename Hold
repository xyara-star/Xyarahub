-- Tool Lock Simple dengan Auto-Relock (Delta Executor)
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- Hapus GUI lama jika ada
if CoreGui:FindFirstChild("SimpleToolLock") then
	CoreGui.SimpleToolLock:Destroy()
end

-- ===== BUAT UI SIMPEL =====
local gui = Instance.new("ScreenGui")
gui.Name = "SimpleToolLock"
gui.ResetOnSpawn = false
gui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 180, 0, 110)
frame.Position = UDim2.new(0, 30, 0.5, -55)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

-- Judul / Status Teks
local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -16, 0, 32)
statusLabel.Position = UDim2.new(0, 8, 0, 8)
statusLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
statusLabel.Text = "Status: Unlocked"
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextSize = 12
statusLabel.Parent = frame

local labelCorner = Instance.new("UICorner")
labelCorner.CornerRadius = UDim.new(0, 6)
labelCorner.Parent = statusLabel

-- Tombol Lock
local lockBtn = Instance.new("TextButton")
lockBtn.Size = UDim2.new(0, 78, 0, 32)
lockBtn.Position = UDim2.new(0, 8, 0, 48)
lockBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
lockBtn.Text = "LOCK"
lockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
lockBtn.Font = Enum.Font.GothamBold
lockBtn.TextSize = 13
lockBtn.Parent = frame

local lockCorner = Instance.new("UICorner")
lockCorner.CornerRadius = UDim.new(0, 6)
lockCorner.Parent = lockBtn

-- Tombol Unlock
local unlockBtn = Instance.new("TextButton")
unlockBtn.Size = UDim2.new(0, 78, 0, 32)
unlockBtn.Position = UDim2.new(1, -86, 0, 48)
unlockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
unlockBtn.Text = "UNLOCK"
unlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
unlockBtn.Font = Enum.Font.GothamBold
unlockBtn.TextSize = 13
unlockBtn.Parent = frame

local unlockCorner = Instance.new("UICorner")
unlockCorner.CornerRadius = UDim.new(0, 6)
unlockCorner.Parent = unlockBtn

-- ===== LOGIKA UTAMA =====
local lockedToolName = nil
local isLocked = false
local loopConnection = nil
local isChecking = false

lockBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end
	
	local currentTool = char:FindFirstChildOfClass("Tool")
	if not currentTool then
		statusLabel.Text = "Pegang item dulu!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
		return
	end
	
	lockedToolName = currentTool.Name
	isLocked = true
	statusLabel.Text = "Locked: " .. lockedToolName
	statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
	
	if loopConnection then loopConnection:Disconnect() end
	
	-- Cek terus setiap frame secara halus
	loopConnection = RunService.Stepped:Connect(function()
		if not isLocked or not lockedToolName then return end
		
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		
		local inHand = character:FindFirstChild(lockedToolName)
		
		-- Jika item terlepas dari tangan dan kita sedang tidak dalam masa tunggu (delay)
		if not inHand and not isChecking then
			isChecking = true
			
			-- Delay sekitar 1 detik sebelum memutuskan untuk nge-lock lagi
			task.delay(1, function()
				if not isLocked then 
					isChecking = false
					return 
				end
				
				local latestChar = player.Character
				if latestChar then
					local latestHumanoid = latestChar:FindFirstChildOfClass("Humanoid")
					local checkHand = latestChar:FindFirstChild(lockedToolName)
					
					-- Jika setelah 1 detik masih belum di tangan, cari di backpack lalu equip lagi
					if not checkHand and latestHumanoid then
						local backpack = player:FindFirstChildOfClass("Backpack")
						if backpack then
							local tool = backpack:FindFirstChild(lockedToolName)
							if tool and tool:IsA("Tool") then
								pcall(function()
									latestHumanoid:EquipTool(tool)
								end)
							end
						end
					end
				end
				
				isChecking = false
			end)
		end
	end)
end)

unlockBtn.MouseButton1Click:Connect(function()
	isLocked = false
	lockedToolName = nil
	isChecking = false
	if loopConnection then
		loopConnection:Disconnect()
		loopConnection = nil
	end
	statusLabel.Text = "Status: Unlocked"
	statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end)
