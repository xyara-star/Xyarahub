-- ===== LOGIKA UI =====
local selectedTool = nil
local isLocked = false

-- Refresh daftar item di backpack/character
local function refreshList()
	for _, child in ipairs(itemList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	local tools = {}

	if backpack then
		for _, t in ipairs(backpack:GetChildren()) do
			if t:IsA("Tool") then
				table.insert(tools, t)
			end
		end
	end
	if char then
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") then
				table.insert(tools, t)
			end
		end
	end

	if #tools == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -8, 0, 32)
		empty.BackgroundTransparency = 1
		empty.Text = "Tidak ada tool"
		empty.TextColor3 = Color3.fromRGB(150, 150, 170)
		empty.Font = Enum.Font.Gotham
		empty.TextSize = 13
		empty.Parent = itemList
		return
	end

	for i, tool in ipairs(tools) do
		local btn = Instance.new("TextButton")
		btn.Name = "Item_" .. tool.Name
		btn.Size = UDim2.new(1, -8, 0, 32)
		btn.Position = UDim2.new(0, 4, 0, (i - 1) * 36 + 4)
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 85)
		btn.Text = tool.Name
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 13
		btn.Parent = itemList

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 5)
		c.Parent = btn

		btn.MouseButton1Click:Connect(function()
			selectedTool = tool
			dropBtn.Text = "Pilih: " .. tool.Name .. "  ▼"
			itemList.Visible = false
		end)
	end

	itemList.CanvasSize = UDim2.new(0, 0, 0, #tools * 36 + 8)
end

-- Toggle dropdown
dropBtn.MouseButton1Click:Connect(function()
	itemList.Visible = not itemList.Visible
	if itemList.Visible then
		refreshList()
	end
end)

-- Update status label
local function updateStatus(locked, name)
	isLocked = locked
	if locked then
		status.Text = "🔒 LOCKED: " .. (name or "?")
		status.TextColor3 = Color3.fromRGB(0, 220, 120)
	else
		status.Text = "🔓 Unlocked"
		status.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

-- ===== HUBUNG KE SERVER =====
local lockEvent = ReplicatedStorage:FindFirstChild("ToolLockEvent")

if not lockEvent then
	status.Text = "⚠️ Warning: RemoteEvent tidak ada!"
	status.TextColor3 = Color3.fromRGB(255, 100, 100)
else
	lockBtn.MouseButton1Click:Connect(function()
		if isLocked then
			status.Text = "Sudah terkunci!"
			return
		end
		local toolName = selectedTool and selectedTool.Name or nil
		if not toolName then
			status.Text = "Pilih item dulu!"
			status.TextColor3 = Color3.fromRGB(255, 180, 80)
			return
		end
		lockEvent:FireServer("Lock", toolName)
	end)

	unlockBtn.MouseButton1Click:Connect(function()
		if not isLocked then
			status.Text = "Belum ada yang dikunci"
			return
		end
		lockEvent:FireServer("Unlock")
	end)

	lockEvent.OnClientEvent:Connect(function(action, locked, toolName)
		if action == "Status" then
			updateStatus(locked, toolName)
		end
	end)

	pcall(function()
		lockEvent:FireServer("CheckStatus")
	end)
end

updateStatus(false, nil)
