--[[
    Tool Lock Pro v3
    - Toggle ON/OFF (satu tombol)
    - Force hold agresif (RenderStepped loop)
    - Listener Unequipped + ChildRemoved
    - Destroy UI = matikan semua fitur
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- ===== HAPUS GUI LAMA =====
local old = CoreGui:FindFirstChild("SimpleToolLock")
if old then old:Destroy() end

-- ===== STATE GLOBAL =====
local isLocked = false
local lockedTool = nil
local conns = {}
local isDestroyed = false

-- ===== HELPER =====
local function clearConns()
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
end

local function addConn(c)
    if c then table.insert(conns, c) end
end

-- ===== UI =====
local gui = Instance.new("ScreenGui")
gui.Name = "SimpleToolLock"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 210, 0, 160)
frame.Position = UDim2.new(0, 30, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(70, 70, 90)
stroke.Thickness = 2
stroke.Parent = frame

-- Status
local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -16, 0, 34)
statusLabel.Position = UDim2.new(0, 8, 0, 8)
statusLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
statusLabel.Text = "Status: OFF"
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextSize = 12
statusLabel.TextWrapped = true
statusLabel.Parent = frame

local labelCorner = Instance.new("UICorner")
labelCorner.CornerRadius = UDim.new(0, 6)
labelCorner.Parent = statusLabel

-- Tombol Toggle ON/OFF
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(1, -16, 0, 40)
toggleBtn.Position = UDim2.new(0, 8, 0, 50)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
toggleBtn.Text = "LOCK (OFF)"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 14
toggleBtn.Parent = frame

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 6)
toggleCorner.Parent = toggleBtn

-- Tombol Destroy
local destroyBtn = Instance.new("TextButton")
destroyBtn.Size = UDim2.new(1, -16, 0, 30)
destroyBtn.Position = UDim2.new(0, 8, 0, 120)
destroyBtn.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
destroyBtn.Text = "✖ DESTROY UI"
destroyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
destroyBtn.Font = Enum.Font.GothamBold
destroyBtn.TextSize = 12
destroyBtn.Parent = frame

local destroyCorner = Instance.new("UICorner")
destroyCorner.CornerRadius = UDim.new(0, 6)
destroyCorner.Parent = destroyBtn

-- ===== LOGIKA =====

local function setStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

-- Equip paksa (tanpa delay)
local function forceEquip()
    if not isLocked or not lockedTool then return end
    if not lockedTool.Parent then return end -- tool sudah hilang

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if lockedTool.Parent == char then return end -- sudah di tangan
    pcall(function()
        hum:EquipTool(lockedTool)
    end)
end

-- Hook tool terkunci
local function hookTool(tool)
    if not tool then return end

    -- Event utama: begitu dilepas, langsung re-equip
    addConn(tool.Unequipped:Connect(function()
        if isLocked and lockedTool == tool then
            task.defer(forceEquip)
        end
    end))

    -- Tool hilang/dijual/hancur
    addConn(tool.AncestryChanged:Connect(function()
        if isLocked and lockedTool == tool and not tool.Parent then
            isLocked = false
            lockedTool = nil
            clearConns()
            setStatus("Item hilang, unlock", Color3.fromRGB(255, 180, 80))
            toggleBtn.Text = "LOCK (OFF)"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
        end
    end))
end

-- Hook karakter
local function hookCharacter(char)
    if not char then return end
    addConn(char.ChildRemoved:Connect(function(child)
        if isLocked and child == lockedTool then
            task.defer(forceEquip)
        end
    end))
end

-- Loop agresif: tiap frame cek apakah tool masih di tangan
local holdConn = RunService.RenderStepped:Connect(function()
    if isDestroyed then return end
    if not isLocked or not lockedTool then return end
    if not lockedTool.Parent then return end

    local char = player.Character
    if not char then return end
    if lockedTool.Parent ~= char then
        forceEquip()
    end
end)

-- ===== TOGGLE ON/OFF =====
toggleBtn.MouseButton1Click:Connect(function()
    if isDestroyed then return end

    if not isLocked then
        -- === NYALAKAN ===
        local char = player.Character
        if not char then return end

        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then
            setStatus("Pegang item dulu!", Color3.fromRGB(255, 180, 80))
            return
        end

        clearConns()
        isLocked = true
        lockedTool = tool

        hookTool(tool)
        hookCharacter(char)

        toggleBtn.Text = "UNLOCK (ON)"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        setStatus("Locked: " .. tool.Name, Color3.fromRGB(0, 220, 120))

        forceEquip()
    else
        -- === MATIKAN ===
        isLocked = false
        lockedTool = nil
        clearConns()

        toggleBtn.Text = "LOCK (OFF)"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
        setStatus("Status: OFF", Color3.fromRGB(255, 255, 255))
    end
end)

-- ===== DESTROY UI =====
destroyBtn.MouseButton1Click:Connect(function()
    isDestroyed = true
    isLocked = false
    lockedTool = nil
    clearConns()
    if holdConn then holdConn:Disconnect() end
    pcall(function() gui:Destroy() end)
    print("[Tool Lock Pro v3] Destroyed")
end)

-- ===== RESPAWN =====
player.CharacterAdded:Connect(function(newChar)
    task.wait(0.5)
    if isDestroyed or not isLocked or not lockedTool then return end

    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack and lockedTool.Parent == backpack then
        local hum = newChar:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:EquipTool(lockedTool) end)
        end
    end
    hookCharacter(newChar)
end)

print("[Tool Lock Pro v3] Loaded")
