-- ==========================================
-- AUTO DETECT EGG LIST DARI GAME
-- ==========================================
local function GetEggListFromGame()
    local eggList = {}
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    -- Cek di Backpack
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            local name = item.Name
            if string.match(string.lower(name), "egg") then
                eggList[name] = true
            end
        end
    end
    
    -- Cek di Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            local name = item.Name
            if string.match(string.lower(name), "egg") and not eggList[name] then
                eggList[name] = true
            end
        end
    end
    
    -- Konversi ke list
    local result = {}
    for name, _ in pairs(eggList) do
        table.insert(result, name)
    end
    return result
end

-- Fungsi untuk update list secara periodik
local function UpdateEggList()
    local newList = GetEggListFromGame()
    if #newList > 0 then
        EGG_LIST = newList
        -- Update UI jika perlu
        if SelectBtn then
            SelectBtn.Text = "🔹 " .. EGG_LIST[selectedEggIndex]
        end
    end
end

-- Jalankan update setiap 5 detik
task.spawn(function()
    while true do
        UpdateEggList()
        task.wait(5)
    end
end)
