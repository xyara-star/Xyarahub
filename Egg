-- LocalScript (StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- DAFTAR NAMA EGG SESUAI TAMPILAN LAYAR
local EGG_LIST = {
    "Rare Egg",
    "Bird Egg",
    "Common Summer Egg",
    "Golden Egg",
    "Enchanted Egg",
    "Common Egg",
    "Coastal Egg",
    "Fall Egg",
    "Legendary Egg",
    "Moon Egg",
    "Mythical Egg",
    "Bug Egg",
    "Gem Egg",
    "Jungle Egg"
}

-- VARIABLE CONTROL
local selectedEggIndex = 1
local isAutoEquipEnabled = false
local equipConnection = nil

-- ==========================================
-- HELPER: Case-insensitive string matching
-- ==========================================
local function matchItemName(itemName)
    local targetEgg = EGG_LIST[selectedEggIndex]
    if not targetEgg then return false end
    return string.lower(itemName):find(string.lower(targetEgg)) ~= nil
end

-- ==========================================
-- FUNCTION AUTO EQUIP / WELD
-- ==========================================
local function WeldItemToHand(item)
    local character = player.Character
    if not character then return end

    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if rightHand and item:IsA("BasePart") then
        item.Parent = character
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rightHand
        weld.Part1 = item
        weld.Parent = rightHand
        item.CFrame = rightHand.CFrame * CFrame.new(0, -1, 0)
    end
end

local function KeepEquipping()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    -- Cek apakah sedang memegang tool yang sesuai
    local toolInCharacter = character:FindFirstChildWhichIsA("Tool")
    if toolInCharacter and matchItemName(toolInCharacter.Name) then
        return
    end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    -- Cari item yang dipilih di backpack
    local foundItem = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if matchItemName(item.Name) then
            foundItem = item
            break
        end
    end

    if foundItem then
        if foundItem:IsA("Tool") then
            humanoid:EquipTool(foundItem)
        elseif foundItem:IsA("BasePart") then
            WeldItemToHand(foundItem)
        else
            local tool = foundItem:FindFirstChildWhichIsA("Tool")
            if tool then
                humanoid:EquipTool(tool)
            end
        end
    end
end

local function StartAutoEquip()
    if not equipConnection then
        equipConnection = RunService.Heartbeat:Connect(KeepEquipping)
    end
end

local function StopAutoEquip()
    if equipConnection then
        equipConnection:Disconnect()
        equipConnection = nil
    end
end

