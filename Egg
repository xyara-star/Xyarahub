-- LocalScript (StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- DAFTAR NAMA EGG SESUAI TAMPILAN LAYAR
local EGG_LIST = {
    "Rare Egg",
    "Bird Egg",
    "Common Summer Egg",
    "Golden Egg",
    "Enchanted Egg",
    "Common Egg",
    "Coastal Egg",
    "Fall Egg",
    "Legendary Egg",
    "Moon Egg",
    "Mythical Egg",
    "Bug Egg",
    "Gem Egg",
    "Jungle Egg"
}

-- VARIABLE CONTROL
local selectedEggIndex = 1
local isAutoEquipEnabled = false
local equipThread = nil

-- KONFIGURASI DELAY (Bisa disesuaikan dalam detik)
local HOLD_DURATION = 1.5   -- Berapa lama item dipegang sebelum dilepas
local RELEASE_DURATION = 0.5 -- Berapa lama jeda lepas item agar SC Auto Sell bisa bekerja

-- ==========================================
-- HELPER: Case-insensitive string matching
-- ==========================================
local function matchItemName(itemName)
    local targetEgg = EGG_LIST[selectedEggIndex]
    if not targetEgg then return false end
    return string.lower(itemName):find(string.lower(targetEgg)) ~= nil
end

-- ==========================================
-- FUNCTION AUTO EQUIP / WELD WITH DELAY
-- ==========================================
local function UnequipCurrentTool(humanoid, character)
    if not humanoid then return end
    
    -- Lepas Tool resmi
    humanoid:UnequipTools()
    
    -- Bersihkan jika ada custom WeldConstraint
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") and matchItemName(child.Name) then
            child.Parent = player:FindFirstChild("Backpack") or workspace
        end
    end
end

local function WeldItemToHand(item, character)
    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if rightHand and item:IsA("BasePart") then
        item.Parent = character
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rightHand
        weld.Part1 = item
        weld.Parent = rightHand
        item.CFrame = rightHand.CFrame * CFrame.new(0, -1, 0)
    end
end

local function EquipCycle()
    while isAutoEquipEnabled do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local backpack = player:FindFirstChild("Backpack")

        if character and humanoid and humanoid.Health > 0 and backpack then
            -- Cari item di backpack
            local foundItem = nil
            for _, item in ipairs(backpack:GetChildren()) do
                if matchItemName(item.Name) then
                    foundItem = item
                    break
                end
            end

            if foundItem then
                -- 1. Equip Item
                if foundItem:IsA("Tool") then
                    humanoid:EquipTool(foundItem)
                elseif foundItem:IsA("BasePart") then
                    WeldItemToHand(foundItem, character)
                else
                    local tool = foundItem:FindFirstChildWhichIsA("Tool")
                    if tool then humanoid:EquipTool(tool) end
                end

                -- 2. Tahan item selama HOLD_DURATION
                task.wait(HOLD_DURATION)

                -- 3. Lepas item sementara agar SC Auto Sell bisa bekerja
                UnequipCurrentTool(humanoid, character)

                -- 4. Jeda sebentar sebelum re-equip berikutnya
                task.wait(RELEASE_DURATION)
            else
                task.wait(0.5) -- Jika item tidak ditemukan, tunggu sebentar sebelum scan ulang
            end
        else
            task.wait(0.5)
        end
    end
end

local function StartAutoEquip()
    if not equipThread then
        isAutoEquipEnabled = true
        equipThread = task.spawn(EquipCycle)
    end
end

local function StopAutoEquip()
    isAutoEquipEnabled = false
    if equipThread then
        equipThread = nil
    end
    
    -- Unequip langsung saat diklik OFF
    if player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        UnequipCurrentTool(humanoid, player.Character)
    end
end

