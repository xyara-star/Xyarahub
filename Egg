--// Xyara Egg Lock v2
--// LocalScript - StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==================================================
-- STATE
--==================================================

local Locked = false
local LockedEggName = nil
local LoopRunning = false

--==================================================
-- GET CHARACTER / HUMANOID
--==================================================

local function GetCharacter()
    return Player.Character
end

local function GetHumanoid()
    local Character = GetCharacter()
    if not Character then return nil end

    return Character:FindFirstChildOfClass("Humanoid")
end

--==================================================
-- GET HELD TOOL
--==================================================

local function GetHeldEgg()
    local Character = GetCharacter()
    if not Character then return nil end

    for _, Item in ipairs(Character:GetChildren()) do
        if Item:IsA("Tool") then
            return Item
        end
    end

    return nil
end

--==================================================
-- FIND EGG
--==================================================

local function FindEgg(Name)
    if not Name then return nil end

    local Character = GetCharacter()
    local Backpack = Player:FindFirstChild("Backpack")

    -- Cari di tangan dulu
    if Character then
        for _, Item in ipairs(Character:GetChildren()) do
            if Item:IsA("Tool") and Item.Name == Name then
                return Item
            end
        end
    end

    -- Cari di backpack
    if Backpack then
        for _, Item in ipairs(Backpack:GetChildren()) do
            if Item:IsA("Tool") and Item.Name == Name then
                return Item
            end
        end
    end

    return nil
end

--==================================================
-- EQUIP LOCKED EGG
--==================================================

local function EquipLockedEgg()
    if not Locked or not LockedEggName then
        return
    end

    local Humanoid = GetHumanoid()
    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    local Held = GetHeldEgg()

    -- Sudah pegang Egg yang benar
    if Held and Held.Name == LockedEggName then
        return
    end

    local Egg = FindEgg(LockedEggName)

    if Egg then
        pcall(function()
            Humanoid:EquipTool(Egg)
        end)
    end
end

--==================================================
-- LOCK
--==================================================

local function LockEgg()
    local Held = GetHeldEgg()

    if not Held then
        Status.Text = "⚠️ Pegang Egg dulu!"
        return
    end

    LockedEggName = Held.Name
    Locked = true

    LockButton.Text = "🔓  UNLOCK"
    LockButton.BackgroundColor3 =
        Color3.fromRGB(45, 190, 80)

    Status.Text = "🔒 LOCKED: " .. LockedEggName

    if not LoopRunning then
        LoopRunning = true

        task.spawn(function()
            while Locked do
                EquipLockedEgg()
                task.wait(0.15)
            end

            LoopRunning = false
        end)
    end
end

--==================================================
-- UNLOCK
--==================================================

local function UnlockEgg()
    Locked = false
    LockedEggName = nil

    LockButton.Text = "🔒  LOCK"
    LockButton.BackgroundColor3 =
        Color3.fromRGB(210, 55, 65)

    Status.Text = "🔓 UNLOCKED"
end

--==================================================
-- GUI
--==================================================

if PlayerGui:FindFirstChild("XyaraEggLock") then
    PlayerGui.XyaraEggLock:Destroy()
end

local GUI = Instance.new("ScreenGui")
GUI.Name = "XyaraEggLock"
GUI.ResetOnSpawn = false
