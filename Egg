-- LocalScript (StarterPlayerScripts)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================
-- DAFTAR EGG
-- ==========================================

local EGG_LIST = {
    "Rare Egg",
    "Common Egg",
    "Coastal Egg",
    "Jungle Egg",
    "Gem Egg",
    "Bug Egg",
}

-- Egg yang sedang dipilih
local selectedEgg = "Rare Egg"

-- CONTROL
local isAutoEquipEnabled = false
local equipConnection = nil

-- ==========================================
-- MATCH NAMA
-- ==========================================

local function matchItemName(itemName)
    return string.lower(itemName) == string.lower(selectedEgg)
end

-- ==========================================
-- WELD ITEM KE TANGAN
-- ==========================================

local function WeldItemToHand(item)

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local rightHand =
        character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")

    if rightHand and item:IsA("BasePart") then

        -- Hapus weld lama
        for _, obj in ipairs(rightHand:GetChildren()) do
            if obj:IsA("WeldConstraint")
            and obj.Name == "AutoHoldWeld" then
                obj:Destroy()
            end
        end

        item.Parent = character

        local weld = Instance.new("WeldConstraint")
        weld.Name = "AutoHoldWeld"
        weld.Part0 = rightHand
        weld.Part1 = item
        weld.Parent = rightHand

        item.CFrame =
            rightHand.CFrame * CFrame.new(0, -1, 0)
    end
end

-- ==========================================
-- KEEP EQUIP
-- ==========================================

local function KeepEquipping()

    if not isAutoEquipEnabled then return end

    local character = player.Character
    if not character then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    -- Kalau egg yang dipilih sudah di tangan
    local currentTool = character:FindFirstChildWhichIsA("Tool")

    if currentTool and matchItemName(currentTool.Name) then
        return
    end

    -- Cari egg pilihan
    local foundItem = nil

    for _, item in ipairs(backpack:GetChildren()) do

        if matchItemName(item.Name) then
            foundItem = item
            break
        end

    end

    if foundItem then

        if foundItem:IsA("Tool") then

            humanoid:EquipTool(foundItem)

        elseif foundItem:IsA("BasePart") then

            WeldItemToHand(foundItem)

        end

    end
end

-- ==========================================
-- START / STOP
-- ==========================================

local function StartAutoEquip()

    if equipConnection then return end

    equipConnection =
        RunService.Heartbeat:Connect(KeepEquipping)
end

local function StopAutoEquip()

    if equipConnection then
        equipConnection:Disconnect()
        equipConnection = nil
    end
end

-- ==========================================
-- UI
-- ==========================================

if playerGui:FindFirstChild("XyaraMinUI") then
