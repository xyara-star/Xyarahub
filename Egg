-- Functions
local function GetRarityColor(name)
    if name:find("Common") then return Color3.fromRGB(128, 128, 128) end
    if name:find("Uncommon") then return Color3.fromRGB(0, 176, 80) end
    if name:find("Rare") then return Color3.fromRGB(0, 112, 255) end
    if name:find("Epic") then return Color3.fromRGB(156, 39, 176) end
    if name:find("Legendary") then return Color3.fromRGB(255, 193, 7) end
    if name:find("Mythic") then return Color3.fromRGB(255, 87, 34) end
    return Color3.fromRGB(200, 200, 200)
end

local function UpdateList()
    -- Clear
    for _, child in pairs(scroll:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    
    local eggs = {}
    local filter = filterBox.Text:lower()
    
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name:find("Egg") then
            local name = item.Name
            if filter == "" or name:lower():find(filter) then
                table.insert(eggs, name)
            end
        end
    end
    
    scroll.CanvasSize = UDim2.new(0, 0, 0, #eggs * 18 + 5)
    
    for _, name in pairs(eggs) do
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.9, 0, 0, 16)
        label.Position = UDim2.new(0.05, 0, 0, 0)
        label.BackgroundColor3 = GetRarityColor(name)
        label.BackgroundTransparency = 0.6
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Text = name
        label.TextScaled = true
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = scroll
        
        -- Tax bar mini
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(0.25, 0, 0.35, 0)
        bar.Position = UDim2.new(0.7, 0, 0.32, 0)
        bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        bar.BorderSizePixel = 0
        bar.Parent = label
        
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(math.random(30, 100) / 100, 0, 1, 0)
        fill.BackgroundColor3 = GetRarityColor(name)
        fill.BorderSizePixel = 0
        fill.Parent = bar
        
        local pct = Instance.new("TextLabel")
        pct.Size = UDim2.new(1, 0, 1, 0)
        pct.BackgroundTransparency = 1
        pct.Text = fill.Size.X.Scale * 100 .. "%"
        pct.TextColor3 = Color3.fromRGB(255, 255, 255)
        pct.TextScaled = true
        pct.Font = Enum.Font.Gotham
        pct.Parent = fill
    end
end

local function IsTarget(name)
    if #Config.TargetEggs == 0 then return true end
    for _, target in pairs(Config.TargetEggs) do
        if name:find(target) then return true end
    end
    return false
end

local function AutoPickup()
    if not Config.Enabled then return end
    
    local char = player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local picked = false
    for _, egg in pairs(workspace:GetDescendants()) do
        if egg:IsA("Tool") and egg.Name:find("Egg") and egg.Parent ~= player and egg.Parent ~= backpack then
            if IsTarget(egg.Name) then
                local handle = egg:FindFirstChild("Handle")
                if handle and (root.Position - handle.Position).Magnitude <= Config.Range then
                    egg.Parent = backpack
                    picked = true
                    task.wait(0.15)
                end
            end
        end
    end
    if picked then
        UpdateList()
    end
end

-- Filter event
filterBox:GetPropertyChangedSignal("Text"):Connect(UpdateList)

-- Toggle
toggle.MouseButton1Click:Connect(function()
    Config.Enabled = not Config.Enabled
    toggle.Text = Config.Enabled and "ON" or "OFF"
