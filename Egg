-- Functions
local PickedCount = 0

local function UpdateTarget()
    local inputText = inputBox.Text
    if inputText ~= "" then
        Config.TargetEggs = {inputText}
        statusLabel.Text = "Target: " .. inputText
        -- Reset processed eggs saat ganti target
        ProcessedEggs = {}
        print("🎯 Target egg: " .. inputText)
    end
end

local function IsTarget(name)
    if #Config.TargetEggs == 0 then return true end
    for _, target in pairs(Config.TargetEggs) do
        if name:find(target) then return true end
    end
    return false
end

local function SafePickup(egg)
    local success, err = pcall(function()
        -- Cek apakah egg masih valid
        if not egg or not egg.Parent then return end
        if egg.Parent == player or egg.Parent == backpack then return end
        
        -- Cek apakah egg sudah dipegang player lain
        if egg.Parent:IsA("Model") and egg.Parent:FindFirstChild("Humanoid") then
            return -- Egg dipegang player lain
        end
        
        -- Pindahkan ke backpack
        egg.Parent = backpack
        PickedCount = PickedCount + 1
        counterLabel.Text = "Picked: " .. tostring(PickedCount)
    end)
    
    if not success then
        warn("⚠️ Gagal pickup egg: " .. tostring(err))
    end
end

local function AutoPickup()
    if not Config.Enabled then return end
    
    local now = tick()
    if now - LastPickup < Config.PickupCooldown then return end
    
    local char = player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Cari egg di workspace dengan cara yang lebih efisien
    local eggs = workspace:GetDescendants()
    local found = false
    
    for _, obj in pairs(eggs) do
        if not Config.Enabled then break end
        
        -- Cek apakah objek adalah Tool dan mengandung "Egg" di namanya
        if obj:IsA("Tool") and obj.Name:find("Egg") then
            -- Skip jika sudah di inventory player
            if obj.Parent == player or obj.Parent == backpack then
                continue
            end
            
            -- Skip jika sudah diproses sebelumnya (berdasarkan instance)
            if ProcessedEggs[obj] then
                continue
            end
            
            -- Cek target
            if IsTarget(obj.Name) then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    local distance = (root.Position - handle.Position).Magnitude
                    if distance <= Config.Range then
                        SafePickup(obj)
                        ProcessedEggs[obj] = true
                        LastPickup = now
                        found = true
                        
                        -- Cleanup processed eggs yang sudah tidak valid
                        task.spawn(function()
                            task.wait(5)
                            ProcessedEggs[obj] = nil
                        end)
                        
                        break -- Pickup satu per frame untuk menghindari lag
                    end
                end
            end
        end
    end
end

-- Events
setBtn.MouseButton1Click:Connect(UpdateTarget)

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        UpdateTarget()
    end
end)

toggle.MouseButton1Click:Connect(function()
    Config.Enabled = not Config.Enabled
    toggle.Text = Config.Enabled and "ON" or "OFF"
    toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(244, 67, 54)
end)

-- Heartbeat dengan interval
local LastCheck = 0
RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - LastCheck >= Config.CheckInterval then
        LastCheck = now
        AutoPickup()
    end
end)

-- Cleanup saat character respawn
player.CharacterAdded:Connect(function()
    backpack = player:WaitForChild("Backpack")
    ProcessedEggs = {}
end)

