--==================================================
-- LOCK BUTTON
--==================================================

LockButton.MouseButton1Click:Connect(function()

    -- LOCK
    if not isLocked then

        local heldItem = GetHeldItem()

        if not heldItem then

            Status.Text = "⚠️ Pegang Egg dulu!"

            task.delay(1.5, function()
                if not isLocked then
                    Status.Text = "🔓 UNLOCKED"
                end
            end)

            return
        end

        -- Simpan nama item yang sedang dipegang
        lockedItemName = heldItem.Name

        StartLock()

        LockButton.Text = "🔓  UNLOCK"

        LockButton.BackgroundColor3 =
            Color3.fromRGB(45, 185, 75)

        Status.Text =
            "🔒 LOCKED: " .. lockedItemName

    -- UNLOCK
    else

        StopLock()

        LockButton.Text = "🔒  LOCK"

        LockButton.BackgroundColor3 =
            Color3.fromRGB(200, 55, 65)

        Status.Text = "🔓 UNLOCKED"
    end
end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function(character)

    if not isLocked then
        return
    end

    task.wait(1)

    KeepLockedItem()
end)

--==================================================
-- BACKPACK UPDATE
--==================================================

local backpack = player:WaitForChild("Backpack")

backpack.ChildAdded:Connect(function(item)

    if not isLocked then
        return
    end

    if item:IsA("Tool") and matchItemName(item.Name) then

        task.wait(0.1)

        KeepLockedItem()
    end
end)

print("================================")
print("[Xyara Egg Lock] Loaded")
print("[Xyara Egg Lock] Pegang Egg > LOCK")
print("================================")
