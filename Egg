--  FUNCTIONS
-- ═══════════════════════════════════════════════════════════════

local function ShowNotification(text, color)
    if not Config.ShowNotifications then return end
    color = color or Color3.fromRGB(100, 255, 100)
    
    NotifText.Text = text
    NotifStroke.Color = color
    NotifFrame.Visible = true
    NotifFrame.BackgroundTransparency = 0.1
    
    task.spawn(function()
        task.wait(1.5)
        for i = 1, 10 do
            NotifFrame.BackgroundTransparency = 0.1 + (i * 0.09)
            task.wait(0.05)
        end
        NotifFrame.Visible = false
    end)
end

local function UpdateTarget()
    local inputText = EggInput.Text
    if inputText ~= "" then
        Config.TargetEggs = {inputText}
        StatusLabel.Text = "Target: " .. inputText
        ShowNotification("🎯 Target: " .. inputText, Color3.fromRGB(100, 200, 255))
        print("[EggPicker] Target set to: " .. inputText)
    end
end

local function IsTarget(name)
    if #Config.TargetEggs == 0 then return true end
    for _, target in pairs(Config.TargetEggs) do
        if name:find(target) then return true end
    end
    return false
end

local function IsValidEgg(egg)
    -- Cek apakah objek masih valid
    if not egg or not egg.Parent then return false end
    
    -- Cek apakah sudah di inventory
    if egg.Parent == player or egg.Parent == backpack then return false end
    
    -- Cek apakah dipegang player lain
    local parent = egg.Parent
    if parent:IsA("Model") then
        local humanoid = parent:FindFirstChildOfClass("Humanoid")
        if humanoid then return false end
    end
    
    -- Cek apakah parent adalah character player lain
    if parent:FindFirstChild("HumanoidRootPart") then return false end
    
    return true
end

local function TryPickupEgg(egg)
    if not IsValidEgg(egg) then return false end
    if State.ProcessedEggs[egg] then return false end
    
    local handle = egg:FindFirstChild("Handle") or egg:FindFirstChildWhichIsA("BasePart")
    if not handle then return false end
    
    local distance = (humanoidRootPart.Position - handle.Position).Magnitude
    if distance > Config.Range then return false end
    
    -- Cek nama target
    if not IsTarget(egg.Name) then return false end
    
    -- Pickup dengan pcall untuk safety
    local success = pcall(function()
        egg.Parent = backpack
    end)
    
    if success then
        State.PickedCount = State.PickedCount + 1
        State.ProcessedEggs[egg] = true
        State.LastPickup = tick()
        
        -- Update stats
        StatsLabel.Text = "Picked: " .. State.PickedCount .. " | Range: " .. Config.Range
        
        -- Auto equip jika diaktifkan
        if Config.AutoEquip then
            task.spawn(function()
                task.wait(0.1)
                pcall(function()
                    humanoid:EquipTool(egg)
                end)
            end)
        end
        
        -- Cleanup processed setelah beberapa detik
        task.delay(3, function()
            State.ProcessedEggs[egg] = nil
        end)
        
        return true
    end
    
    return false
end

local function FindAndPickupEggs()
    if not Config.Enabled then return end
    if State.IsSearching then return end
    
    local now = tick()
    if now - State.LastPickup < Config.PickupCooldown then return end
    if now - State.LastCheck < Config.CheckInterval then return end
    State.LastCheck = now
    
    State.IsSearching = true
    
    -- Update character reference
    character = player.Character
    if not character then 
        State.IsSearching = false
        return 
    end
    
    humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then 
        State.IsSearching = false
        return 
    end
    
    -- Cari egg di workspace
    local descendants = workspace:GetDescendants()
    local pickedAny = false
    
    for _, obj in pairs(descendants) do
        if not Config.Enabled then break end
        
        -- Cek apakah objek adalah Tool dengan nama mengandung "Egg"
        if obj:IsA("Tool") and obj.Name:find("Egg") then
            if TryPickupEgg(obj) then
                pickedAny = true
                ShowNotification("✅ Picked: " .. obj.Name)
                break -- Pickup satu per frame
            end
        end
    end
    
    State.IsSearching = false
end

