-- LocalScript (StarterPlayerScripts)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================
-- VARIABLE
-- ==========================================
local EGG_LIST = {"Common Egg", "Rare Egg", "Golden Egg"} -- Default fallback
local selectedEggIndex = 1
local isAutoEquipEnabled = false
local equipConnection = nil

-- ==========================================
-- FUNGSI SCAN EGG SEDERHANA
-- ==========================================
local function ScanForEggs()
    local found = {}
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    -- Scan backpack
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            local name = item.Name
            if string.lower(name):find("egg") then
                found[name] = true
            end
        end
    end
    
    -- Scan character
    if character then
        for _, item in pairs(character:GetChildren()) do
            local name = item.Name
            if string.lower(name):find("egg") then
                found[name] = true
            end
        end
    end
    
    -- Convert ke list
    local result = {}
    for name, _ in pairs(found) do
        table.insert(result, name)
    end
    table.sort(result)
    
    if #result > 0 then
        EGG_LIST = result
        if selectedEggIndex > #EGG_LIST then
            selectedEggIndex = 1
        end
        return true
    end
    return false
end

-- ==========================================
-- MATCHING
-- ==========================================
local function matchItemName(itemName)
    if #EGG_LIST == 0 then
        ScanForEggs()
    end
    local target = EGG_LIST[selectedEggIndex]
    if not target then return false end
    return string.lower(itemName):find(string.lower(target)) ~= nil
end

-- ==========================================
-- AUTO HOLD
-- ==========================================
local function WeldItemToHand(item)
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if rightHand and item:IsA("BasePart") then
        item.Parent = character
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rightHand
        weld.Part1 = item
        weld.Parent = rightHand
        item.CFrame = rightHand.CFrame * CFrame.new(0, -1, 0)
    end
end

local function KeepEquipping()
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    -- Cek apakah sudah pegang tool
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Tool") then
            return -- Sudah pegang, skip
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    -- Cari item di backpack
    local foundItem = nil
    for _, item in pairs(backpack:GetChildren()) do
        if matchItemName(item.Name) then
            foundItem = item
            break
        end
    end

    if foundItem then
        if foundItem:IsA("Tool") then
            humanoid:EquipTool(foundItem)
        elseif foundItem:IsA("BasePart") then
            WeldItemToHand(foundItem)
        end
    end
end

-- ==========================================
-- START/STOP
-- ==========================================
local function StartAutoEquip()
    if not equipConnection then
        isAutoEquipEnabled = true
        equipConnection = RunService.Heartbeat:Connect(KeepEquipping)
        print("[AutoHold] Started")
    end
end

local function StopAutoEquip()
    isAutoEquipEnabled = false
    if equipConnection then
        equipConnection:Disconnect()
        equipConnection = nil
        print("[AutoHold] Stopped")
    end
    
    if player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:UnequipTools()
        end
    end
end

