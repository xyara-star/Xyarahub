--// Xyara Egg Lock
--// LocalScript - StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================
-- VARIABLES
--==================================================

local isLocked = false
local lockedItemName = nil
local equipConnection = nil

--==================================================
-- FIND CURRENT HELD ITEM
--==================================================

local function GetHeldItem()
    local character = player.Character
    if not character then return nil end

    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            return item
        end
    end

    return nil
end

--==================================================
-- MATCH ITEM NAME
--==================================================

local function matchItemName(itemName)
    if not lockedItemName then
        return false
    end

    return string.lower(itemName):find(
        string.lower(lockedItemName),
        1,
        true
    ) ~= nil
end

--==================================================
-- FIND LOCKED ITEM
--==================================================

local function FindLockedItem()
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    -- Cek Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and matchItemName(item.Name) then
                return item
            end
        end
    end

    -- Cek Backpack
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and matchItemName(item.Name) then
                return item
            end
        end
    end

    return nil
end

--==================================================
-- WELD FALLBACK
--==================================================

local function WeldItemToHand(item)

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local rightHand =
        character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")

    if rightHand and item:IsA("BasePart") then

        item.Parent = character

        local oldWeld = item:FindFirstChild("XyaraEggWeld")

        if oldWeld then
            oldWeld:Destroy()
        end

        local weld = Instance.new("WeldConstraint")
        weld.Name = "XyaraEggWeld"
        weld.Part0 = rightHand
        weld.Part1 = item
        weld.Parent = item

        item.CFrame =
            rightHand.CFrame * CFrame.new(0, -1, 0)
    end
end

--==================================================
-- KEEP LOCKED ITEM EQUIPPED
--==================================================

local function KeepLockedItem()

    if not isLocked then
        return
    end

    if not lockedItemName then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return
    end

    -- Item yang sedang dipegang
    local currentItem = GetHeldItem()

    -- Kalau sudah benar, jangan ngapa-ngapain
    if currentItem and matchItemName(currentItem.Name) then
        return
    end

    -- Cari item yang dikunci
    local foundItem = FindLockedItem()

    if not foundItem then
        return
    end

    -- Kalau sedang pegang item lain,
    -- lepas dulu supaya target bisa di-equip
    if currentItem then
        humanoid:UnequipTools()
        task.wait()
    end

    -- Equip Tool
    if foundItem:IsA("Tool") then

        pcall(function()
            humanoid:EquipTool(foundItem)
        end)

    elseif foundItem:IsA("BasePart") then

        WeldItemToHand(foundItem)

    else

        -- Fallback kalau item punya Tool di dalamnya
        local tool =
            foundItem:FindFirstChildWhichIsA("Tool", true)

        if tool then
            pcall(function()
                humanoid:EquipTool(tool)
            end)
        end
    end
end

--==================================================
-- START LOCK
--==================================================

local function StartLock()

    if not lockedItemName then
        return
    end

    isLocked = true

    if equipConnection then
        equipConnection:Disconnect()
    end

    equipConnection =
        RunService.Heartbeat:Connect(KeepLockedItem)

    print("[Xyara] LOCKED:", lockedItemName)
end

--==================================================
-- STOP LOCK
--==================================================

local function StopLock()

    isLocked = false
    lockedItemName = nil

    if equipConnection then
        equipConnection:Disconnect()
        equipConnection = nil
    end

    print("[Xyara] UNLOCKED")
end

