-- Ganti fungsi KeepEquipping lama kamu dengan ini:

local function KeepEquipping()
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Cek apakah sudah ada tool di tangan
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool and currentTool.Name == ITEM_NAME then 
        return -- Sudah dipegang, tidak perlu melakukan apa-apa
    end
    
    -- Mencari item di Backpack dengan cara yang lebih toleran
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local foundTool = nil
        
        -- Loop untuk mencari nama yang mirip (Case-insensitive)
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), string.lower(ITEM_NAME)) then
                foundTool = item
                break
            end
        end
        
        if foundTool then
            humanoid:EquipTool(foundTool)
            print("Berhasil Equip: " .. foundTool.Name)
        end
    end
end
