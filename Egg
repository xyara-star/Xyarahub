-- LocalScript | StarterPlayerScripts
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", 10)
if not playerGui then return end

-- =========================
-- STATE
-- =========================
local locked = false
local lockedEggName = nil
local equipConnection = nil

-- =========================
-- GET CURRENT HELD ITEM
-- =========================
local function getHeldTool()
    local character = player.Character
    if not character then return nil end

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Tool") then
            return obj
        end
    end

    return nil
end

-- =========================
-- FIND LOCKED EGG
-- =========================
local function findLockedEgg()
    if not locked or not lockedEggName then
        return nil
    end

    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    -- Sudah di tangan
    if character then
        for _, obj in ipairs(character:GetChildren()) do
            if obj:IsA("Tool") and obj.Name == lockedEggName then
                return obj
            end
        end
    end

    -- Ada di backpack
    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") and obj.Name == lockedEggName then
                return obj
            end
        end
    end

    return nil
end

-- =========================
-- EQUIP LOCKED EGG
-- =========================
local function equipLockedEgg()
    if not locked or not lockedEggName then
        return
    end

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local held = getHeldTool()

    -- Kalau sudah pegang Egg yang dikunci
    if held and held.Name == lockedEggName then
        return
    end

    local egg = findLockedEgg()

    if egg and egg.Parent ~= character then
        humanoid:EquipTool(egg)
    end
end

-- =========================
-- START LOCK
-- =========================
local function lockCurrentEgg()
    local held = getHeldTool()

    if not held then
        StatusLabel.Text = "⚠️ Pegang Egg dulu!"
        return
    end

    lockedEggName = held.Name
    locked = true

    LockBtn.Text = "🔓 UNLOCK"
    LockBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 80)
    StatusLabel.Text = "🔒 LOCKED: " .. lockedEggName

    if equipConnection then
        equipConnection:Disconnect()
    end

    equipConnection = RunService.Heartbeat:Connect(function()
        equipLockedEgg()
    end)
end

-- =========================
-- UNLOCK
-- =========================
local function unlockEgg()
    locked = false
    lockedEggName = nil

    if equipConnection then
        equipConnection:Disconnect()
        equipConnection = nil
    end

    LockBtn.Text = "🔒 LOCK"
    LockBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 70)
    StatusLabel.Text = "🔓 UNLOCKED"
end

