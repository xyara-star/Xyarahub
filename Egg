-- =========================
-- BUTTON
-- =========================
LockBtn.MouseButton1Click:Connect(function()
    if locked then
        unlockEgg()
    else
        lockCurrentEgg()
    end
end)

-- =========================
-- RESPAWN SUPPORT
-- =========================
player.CharacterAdded:Connect(function(character)
    if locked then
        character:WaitForChild("Humanoid", 5)
        task.wait(0.5)
        equipLockedEgg()
    end
end)

-- =========================
-- TOUCH FEEDBACK
-- =========================
