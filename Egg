local function UpdateDebug(text)
    if Config.ShowDebug then
        DebugLabel.Text = "Debug: " .. text
        print("[EggPicker] " .. text)
    end
end

local function IsTarget(name)
    local target = TargetInput.Text
    if target == "" or target == "All" then return true end
    return name:find(target) ~= nil
end

-- ═══════════════════════════════════════════════════════════════
--  METHOD 1: ProximityPrompt (paling umum di Grow a Garden)
-- ═══════════════════════════════════════════════════════════════

local function TryPromptPickup(egg)
    local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        -- Cek di children langsung
        for _, child in pairs(egg:GetChildren()) do
            if child:IsA("ProximityPrompt") then
                prompt = child
                break
            end
        end
    end
    
    if prompt then
        local success, err = pcall(function()
            -- Method 1a: Fire prompt directly
            fireproximityprompt(prompt)
        end)
        
        if success then
            UpdateDebug("✅ Prompt fired for " .. egg.Name)
            return true
        else
            UpdateDebug("❌ Prompt fire failed: " .. tostring(err))
        end
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  METHOD 2: ClickDetector
-- ═══════════════════════════════════════════════════════════════

local function TryClickPickup(egg)
    local clickDetector = egg:FindFirstChildWhichIsA("ClickDetector", true)
    if not clickDetector then
        for _, child in pairs(egg:GetChildren()) do
            if child:IsA("ClickDetector") then
                clickDetector = child
                break
            end
        end
    end
    
    if clickDetector then
        local success = pcall(function()
            fireclickdetector(clickDetector)
        end)
        if success then
            UpdateDebug("✅ ClickDetector fired for " .. egg.Name)
            return true
        end
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  METHOD 3: TouchInterest (untuk part yang bisa di-touch)
-- ═══════════════════════════════════════════════════════════════

local function TryTouchPickup(egg)
    local handle = egg:FindFirstChild("Handle") or egg:FindFirstChildWhichIsA("BasePart")
    if not handle then return false end
    
    local touchInterest = handle:FindFirstChild("TouchInterest")
    if touchInterest then
        local success = pcall(function()
            -- Simulasi touch dengan firetouchinterest
            firetouchinterest(humanoidRootPart, handle, 0) -- Begin touch
            task.wait(0.05)
            firetouchinterest(humanoidRootPart, handle, 1) -- End touch
        end)
        if success then
            UpdateDebug("✅ Touch fired for " .. egg.Name)
            return true
        end
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  METHOD 4: RemoteEvent (cari remote untuk pickup)
-- ═══════════════════════════════════════════════════════════════

local function TryRemotePickup(egg)
    -- Cari common remote names
    local remoteNames = {
        "Pickup", "PickUp", "Collect", "Grab", "Take",
        "EggPickup", "ItemPickup", "ToolPickup",
        "Interact", "Use", "Activate"
    }
    
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") 
        or ReplicatedStorage:FindFirstChild("RemoteEvents")
        or ReplicatedStorage:FindFirstChild("Events")
    
    if remotesFolder then
        for _, name in pairs(remoteNames) do
            local remote = remotesFolder:FindFirstChild(name)
            if remote and remote:IsA("RemoteEvent") then
                local success = pcall(function()
                    remote:FireServer(egg)
                end)
                if success then
                    UpdateDebug("✅ Remote fired: " .. name)
                    return true
                end
            end
        end
    end
    
    -- Cek langsung di ReplicatedStorage
    for _, name in pairs(remoteNames) do
        local remote = ReplicatedStorage:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then
            local success = pcall(function()
                remote:FireServer(egg)
            end)
            if success then
                UpdateDebug("✅ Remote fired: " .. name)
                return true
            end
        end
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  METHOD 5: Tool Parent (hanya jika egg adalah Tool)
-- ═══════════════════════════════════════════════════════════════

local function TryToolPickup(egg)
    if not egg:IsA("Tool") then return false end
    
    -- JANGAN paksa parent ke backpack! Ini yang menyebabkan bug!
    -- Sebaliknya, coba equip tool jika sudah di dekat
    local handle = egg:FindFirstChild("Handle") or egg:FindFirstChildWhichIsA("BasePart")
    if not handle then return false end
    
    local distance = (humanoidRootPart.Position - handle.Position).Magnitude
    if distance > 5 then return false end -- Hanya jika sangat dekat
    
    -- Coba equip tool (bukan pindah parent!)
    local success = pcall(function()
        humanoid:EquipTool(egg)
    end)
    
    if success then
        UpdateDebug("✅ Tool equipped: " .. egg.Name)
        return true
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  MAIN PICKUP FUNCTION
-- ═══════════════════════════════════════════════════════════════

local function AttemptPickup(egg)
    if not egg or not egg.Parent then return false end
    
    local now = tick()
    if now - State.LastPickup < Config.PickupCooldown then return false end
    
    -- Cek jarak
    local handle = egg:FindFirstChild("Handle") or egg:FindFirstChildWhichIsA("BasePart")
    if not handle then return false end
    
    local distance = (humanoidRootPart.Position - handle.Position).Magnitude
    if distance > Config.Range then return false end
    
    -- Cek target
    if not IsTarget(egg.Name) then return false end
    
    UpdateDebug("Found: " .. egg.Name .. " | Dist: " .. math.floor(distance))
    
    -- Coba semua metode sesuai config
    local methods = {
        Prompt = {TryPromptPickup},
        Click = {TryClickPickup},
        Touch = {TryTouchPickup},
        Remote = {TryRemotePickup},
        Tool = {TryToolPickup},
        All = {TryPromptPickup, TryClickPickup, TryTouchPickup, TryRemotePickup, TryToolPickup}
    }
    
    local toTry = methods[Config.Method] or methods.All
    
    for _, method in pairs(toTry) do
        local success = method(egg)
        if success then
            State.LastPickup = now
            State.PickedCount = State.PickedCount + 1
            StatsLabel.Text = "Picked: " .. State.PickedCount .. " | Method: " .. Config.Method
            return true
        end
    end
    
    return false
end

-- ═══════════════════════════════════════════════════════════════
--  SCANNING
-- ═══════════════════════════════════════════════════════════════

local function ScanForEggs()
    if not Config.Enabled then return end
    if State.IsSearching then return end
    
    local now = tick()
    if now - State.LastCheck < Config.CheckInterval then return end
    State.LastCheck = now
    
    State.IsSearching = true
    
    -- Update references
    character = player.Character
    if not character then 
        State.IsSearching = false
        return 
    end
    
    humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoidRootPart or not humanoid then 
        State.IsSearching = false
        return 
    end
    
    -- Cari egg di workspace
    local found = false
    for _, obj in pairs(workspace:GetDescendants()) do
        if not Config.Enabled then break end
        
        -- Cek apakah nama mengandung "Egg"
        if obj.Name:find("Egg") and obj ~= player then
            -- Skip jika sudah di inventory
            if obj.Parent == player or obj.Parent == player:FindFirstChild("Backpack") then
                continue
            end
            
            -- Skip jadi bagian dari karakter lain
            if obj.Parent and obj.Parent:FindFirstChild("Humanoid") then
                continue
            end
            
            if AttemptPickup(obj) then
                found = true
                break -- Satu per frame
            end
        end
    end
    
    if not found then
        UpdateDebug("Scanning... No eggs in range")
    end
    
    State.IsSearching = false
end

