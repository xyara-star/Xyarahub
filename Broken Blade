--// PRESS KEY
local function PressKey(key)
    local kc = Enum.KeyCode[key]
    if not kc then return end
    pcall(function()
        VIM:SendKeyEvent(true, kc, false, game)
        task.wait()
        VIM:SendKeyEvent(false, kc, false, game)
    end)
end

--// AIM LOCK
RunService.RenderStepped:Connect(function()
    if not Config.AimLock then return end
    if not CurrentTarget then return end
    
    local targetPart = CurrentTarget:FindFirstChild(Config.AimPart) 
        or CurrentTarget:FindFirstChild("HumanoidRootPart") 
        or CurrentTarget:FindFirstChild("Head")
    
    if targetPart then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
    end
end)

--// AUTO SKILL LOOP
task.spawn(function()
    while true do
        task.wait(0.03)
        
        if not Config.AutoSkill then
            task.wait(0.3)
            continue
        end
        
        if not SelectedTargetName then
            task.wait(0.3)
            continue
        end
        
        local target = FindEnemyByName(SelectedTargetName)
        if not target then
            task.wait(0.3)
            continue
        end
        
        local hum = target:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            task.wait(0.5)
            continue
        end
        
        CurrentTarget = target
        
        for _, s in ipairs(Skills) do
            if s.Enabled then
                PressKey(s.Key)
                task.wait(0.008)
            end
        end
    end
end)

--// MAIN UPDATE LOOP
task.spawn(function()
    while true do
        task.wait(0.2)
        
        UpdateBossListUI()
        
        if SelectedTargetName then
            local target = FindEnemyByName(SelectedTargetName)
            
            if target then
                local hum = target:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    CurrentTarget = target
                    local hpPercent = hum.Health / hum.MaxHealth
                    StatusText.Text = string.format("⚔️ %s [❤️ %.0f%%]", SelectedTargetName, hpPercent * 100)
                    
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local targetRoot = target:FindFirstChild("HumanoidRootPart")
                    if hrp and targetRoot then
                        local dist = (hrp.Position - targetRoot.Position).Magnitude
                        TargetInfo.Text = string.format("🎯 %s\n❤️ %.0f/%.0f | 📍 %.0f", 
                            SelectedTargetName, hum.Health, hum.MaxHealth, dist)
                    else
                        TargetInfo.Text = string.format("🎯 %s\n❤️ %.0f/%.0f", SelectedTargetName, hum.Health, hum.MaxHealth)
                    end
                    TargetInfo.BackgroundColor3 = Color3.fromRGB(30,40,30)
                    TargetInfo.Visible = true
                else
                    CurrentTarget = nil
                    TargetInfo.Text = "💀 WAITING: " .. SelectedTargetName
                    TargetInfo.BackgroundColor3 = Color3.fromRGB(40,30,30)
                    StatusText.Text = "⏳ Waiting for " .. SelectedTargetName
                end
            else
                CurrentTarget = nil
                TargetInfo.Text = "🔍 SEARCHING: " .. SelectedTargetName
                TargetInfo.BackgroundColor3 = Color3.fromRGB(40,40,30)
                StatusText.Text = "🔍 Searching for " .. SelectedTargetName
            end
        else
            TargetInfo.Visible = false
            local enemies = GetAllNearbyEnemies()
            if #enemies > 0 and not isMinimized then
                StatusText.Text = "🔍 " .. enemies[1].Model.Name .. " nearby"
            elseif not isMinimized then
                StatusText.Text = "😴 No enemies"
            end
        end
    end
end)

