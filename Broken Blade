--// CORE FUNCTIONS

local function IsEnemy(model)
    if not model or not model.Parent then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function GetAllNearbyEnemies()
    local enemies = {}
    local char = LP.Character
    if not char then return enemies end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return enemies end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsEnemy(obj) then
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if root then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= Config.Radius then
                    table.insert(enemies, {
                        Model = obj,
                        Distance = dist,
                        Humanoid = obj:FindFirstChildOfClass("Humanoid"),
                        Root = root
                    })
                end
            end
        end
    end
    
    table.sort(enemies, function(a, b) return a.Distance < b.Distance end)
    
    local maxEnemies = {}
    for i = 1, math.min(3, #enemies) do
        table.insert(maxEnemies, enemies[i])
    end
    return maxEnemies
end

local function FindEnemyByName(name)
    local enemies = GetAllNearbyEnemies()
    for _, enemy in ipairs(enemies) do
        if enemy.Model.Name == name then
            return enemy.Model
        end
    end
    return nil
end

