    minimized = not minimized; Body.Visible = not minimized; StatusBar.Visible = not minimized
    TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Size = minimized and UDim2.new(0, FULL_W, 0, 30) or UDim2.new(0, FULL_W, 0, FULL_H) }):Play()
    MinBtn.Text = minimized and "+" or "–"
end)

CloseBtn.MouseButton1Click:Connect(function()
