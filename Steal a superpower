-- ================= HELPERS =================
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end
local function isCharacterPart(obj)
    local char = LocalPlayer.Character
    if not char then return false end
    return obj:IsDescendantOf(char)
end
local function getNPCRoot(npc)
    return npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
        or npc:FindFirstChildWhichIsA("BasePart")
end

-- ================= UI HELPERS =================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, c, t)
    return new("UIStroke", { Color = c, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

