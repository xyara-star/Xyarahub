local function applyNoClip()
    if NoClipConn then NoClipConn:Disconnect() end
    NoClipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end
local function stopNoClip()
    if NoClipConn then NoClipConn:Disconnect(); NoClipConn = nil end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "Torso" or part.Name == "UpperTorso"
                    or part.Name == "LowerTorso" or part.Name == "Head" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ===================================================
-- HIDE ALL LOGIC
-- ===================================================
local function applyHide()
    SavedData = { parts = {}, decals = {}, guis = {}, effects = {}, lighting = {} }
    local counts = { parts = 0, effects = 0 }
    if HideOpts.Buildings then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not isCharacterPart(obj) then
                SavedData.parts[obj] = { Transparency = obj.Transparency, Reflectance = obj.Reflectance }
                obj.Transparency = 1
                obj.Reflectance = 0
                counts.parts = counts.parts + 1
            end
        end
    end
    if HideOpts.Effects then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")
                or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
                or obj:IsA("Highlight") then
                if not isCharacterPart(obj) then
                    SavedData.effects[obj] = { Enabled = obj.Enabled }
                    obj.Enabled = false
                    counts.effects = counts.effects + 1
                end
            end
            if (obj:IsA("Decal") or obj:IsA("Texture")) and not isCharacterPart(obj) then
                SavedData.decals[obj] = { Transparency = obj.Transparency }
                obj.Transparency = 1
            end
        end
    end
    setStatus(string.format("Hidden: %d parts, %d effects", counts.parts, counts.effects), SUCCESS)
end

local function restoreAll()
    for obj, data in pairs(SavedData.parts) do
        pcall(function()
            if obj and obj.Parent then
                obj.Transparency = data.Transparency or 0
                if data.Reflectance then obj.Reflectance = data.Reflectance end
            end
        end)
    end
    for obj, data in pairs(SavedData.decals) do
        pcall(function()
            if obj and obj.Parent then obj.Transparency = data.Transparency or 0 end
        end)
    end
    for obj, data in pairs(SavedData.effects) do
        pcall(function()
            if obj and obj.Parent then obj.Enabled = data.Enabled or true end
        end)
    end
    SavedData = { parts = {}, decals = {}, guis = {}, effects = {}, lighting = {} }
end

-- ===================================================
-- FARM LOGIC (Point 1 <-> Point 2)
-- ===================================================
-- Cek apakah posisi di dalam "koridor" antara P1 dan P2
-- (pakai bounding box + margin)
local function inFarmZone(pos)
    if not FarmPoint1 or not FarmPoint2 then return false end
    local minX = math.min(FarmPoint1.X, FarmPoint2.X)
    local maxX = math.max(FarmPoint1.X, FarmPoint2.X)
    local minZ = math.min(FarmPoint1.Z, FarmPoint2.Z)
    local maxZ = math.max(FarmPoint1.Z, FarmPoint2.Z)
    local margin = 50  -- toleransi 50 stud di pinggir
    return pos.X >= (minX - margin) and pos.X <= (maxX + margin)
       and pos.Z >= (minZ - margin) and pos.Z <= (maxZ + margin)
end

-- Cari NPC di dalam farm zone, urut berdasarkan jarak ke P2 (yang paling jauh dulu)
local function scanNPCsInZone()
    if not FarmPoint1 or not FarmPoint2 then return {} end
    local results = {}
    local char = LocalPlayer.Character

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local model = obj.Parent
            if model and model:IsA("Model")
                and not Players:GetPlayerFromCharacter(model)
                and model ~= char then
                local root = getNPCRoot(model)
                if root and inFarmZone(root.Position) then
                    local distToP2 = (root.Position - FarmPoint2).Magnitude
                    table.insert(results, { model = model, hum = obj, root = root, distToP2 = distToP2 })
                end
            end
        end
    end
    -- Urut dari yang paling deket ke P2 (biar maju dulu, baru balik)
    table.sort(results, function(a, b) return a.distToP2 < b.distToP2 end)
    return results
end

local function teleportToNPC(npc)
    local hrp = getHRP()
    if not hrp then return end
    local root = getNPCRoot(npc)
    if not root then return end
    hrp.CFrame = root.CFrame * CFrame.new(0, 0, 3)
end

-- Cek apakah player sudah dekat P2 (buat trigger balik)
local function nearP2(hrp)
    if not FarmPoint2 then return false end
    local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
        - Vector3.new(FarmPoint2.X, 0, FarmPoint2.Z)).Magnitude
    return dist < 15
end

-- Cek apakah player sudah dekat P1
local function nearP1(hrp)
    if not FarmPoint1 then return false end
    local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
        - Vector3.new(FarmPoint1.X, 0, FarmPoint1.Z)).Magnitude
    return dist < 15
end

-- Gerak menuju target (pakai velocity)
local function moveToward(hrp, targetPos, speed)
    local now = os.clock()
    local horizontal = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    if horizontal.Magnitude < 0.5 then return end
    local dir = horizontal.Unit

    local moved = (hrp.Position - lastFarmPos).Magnitude
    if moved < 1.5 then stuckTimer = stuckTimer + 0.1 else stuckTimer = 0 end
    lastFarmPos = hrp.Position

    if stuckTimer >= STUCK_TIME and not climbing then
        climbing = true
        climbEndTime = now + CLIMB_DURATION
    end
    if climbing and now >= climbEndTime then
        climbing = false; stuckTimer = 0
    end

    local yVel = 0
    if climbing then
        yVel = 40
    else
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character }
        params.IgnoreWater = true
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0,-15,0), params)
        if ray then
            local desiredY = ray.Position.Y + 3
            local diff = desiredY - hrp.Position.Y
            yVel = math.clamp(diff * 8, -25, 25)
        end
    end

    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, yVel, dir.Z * speed)
end

-- Farm loop
task.spawn(function()
    while true do
        task.wait(0.15)

        if not AutoFarmEnabled then
            if FarmPhase ~= "IDLE" then
                FarmPhase = "IDLE"
                currentTarget = nil
                local hum = getHumanoid()
                if hum then hum.WalkSpeed = 16 end
                local hrp = getHRP()
                if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0,0,0) end
            end
            continue
        end

        local hrp = getHRP()
        if not hrp then continue end
        if not FarmPoint1 or not FarmPoint2 then
            setStatus("Set Point 1 & 2 first!", WARN)
            task.wait(0.5)
            continue
        end

        -- Start phase: kalau masih IDLE, mulai FARMING_TO_P2
        if FarmPhase == "IDLE" then
            FarmPhase = "FARMING_TO_P2"
            lastFarmPos = hrp.Position
            stuckTimer = 0
            setStatus("Farm started: P1 → P2", ACCENT2)
        end

        -- ============ FARMING_TO_P2 ============
        if FarmPhase == "FARMING_TO_P2" then
            -- Cek udah deket P2? → balik
            if nearP2(hrp) then
                setStatus("Reached P2! Going back to P1...", SUCCESS)
                FarmPhase = "RETURNING_TO_P1"
                currentTarget = nil
                task.wait(0.3)
                continue
            end

            -- Validasi current target
            if currentTarget then
                local hum = currentTarget:FindFirstChildOfClass("Humanoid")
                local root = getNPCRoot(currentTarget)
                if not hum or hum.Health <= 0 or not currentTarget.Parent or not root
                    or not inFarmZone(root.Position) then
                    currentTarget = nil
                end
            end

            -- Cari target baru
            if not currentTarget then
                local now = os.clock()
                if now - lastTargetRefresh > 0.4 then
                    lastTargetRefresh = now
                    local npcs = scanNPCsInZone()
                    if #npcs > 0 then
                        currentTarget = npcs[1].model
                    end
                end
            end

            -- Eksekusi
            if currentTarget then
                teleportToNPC(currentTarget)
                setStatus("[P1→P2] Farming: " .. currentTarget.Name, ACCENT2)
            else
                -- Ga ada NPC, jalan menuju P2
                moveToward(hrp, FarmPoint2, FarmSpeed)
                local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z)
                    - Vector3.new(FarmPoint2.X,0,FarmPoint2.Z)).Magnitude
                setStatus(string.format("[P1→P2] Moving | %dm", math.floor(dist)), ACCENT2)
            end

        -- ============ RETURNING_TO_P1 ============
        elseif FarmPhase == "RETURNING_TO_P1" then
            if nearP1(hrp) then
                setStatus("Reached P1! Going to P2 again...", SUCCESS)
                FarmPhase = "FARMING_TO_P2"
                currentTarget = nil
                lastFarmPos = hrp.Position
                stuckTimer = 0
                task.wait(0.3)
                continue
            end

            -- Validasi current target (boleh farm sambil balik juga)
            if currentTarget then
                local hum = currentTarget:FindFirstChildOfClass("Humanoid")
                local root = getNPCRoot(currentTarget)
                if not hum or hum.Health <= 0 or not currentTarget.Parent or not root
                    or not inFarmZone(root.Position) then
                    currentTarget = nil
                end
            end

            if not currentTarget then
                local now = os.clock()
                if now - lastTargetRefresh > 0.4 then
                    lastTargetRefresh = now
                    local npcs = scanNPCsInZone()
                    if #npcs > 0 then
                        -- Saat balik, pilih NPC yang deket P1
                        table.sort(npcs, function(a, b)
                            local aD = (a.root.Position - FarmPoint1).Magnitude
                            local bD = (b.root.Position - FarmPoint1).Magnitude
                            return aD < bD
                        end)
                        currentTarget = npcs[1].model
                    end
                end
            end

            if currentTarget then
                teleportToNPC(currentTarget)
                setStatus("[P2→P1] Farming: " .. currentTarget.Name, SUCCESS)
            else
                moveToward(hrp, FarmPoint1, FarmSpeed)
                local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z)
                    - Vector3.new(FarmPoint1.X,0,FarmPoint1.Z)).Magnitude
                setStatus(string.format("[P2→P1] Moving | %dm", math.floor(dist)), SUCCESS)
            end
        end
    end
end)

-- ===================================================
-- WALK LOGIC
-- ===================================================
local function stopWalkMotion()
    local hum = getHumanoid()
    if hum then hum.WalkSpeed = 16 end
    local hrp = getHRP()
    if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0,0,0) end
    walkClimbing = false
    walkStuckTimer = 0
end

local function obstacleAhead(hrp, dir, dist)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local ray = workspace:Raycast(hrp.Position, dir.Unit * dist, params)
    if not ray then return false end
    local hit = ray.Instance
    if not hit then return false end
    if not hit.CanCollide then return false end
    if hit.Transparency >= 0.7 then return false end
    if hit.Size.Magnitude < 4 then return false end
    return true
end

local function groundBelow(hrp, maxDist)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local ray = workspace:Raycast(hrp.Position, Vector3.new(0,-maxDist,0), params)
    if ray then return ray.Position.Y end
    return nil
end

local function walkMoveToward(hrp, targetPos, speed)
    local now = os.clock()
    local horizontal = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    if horizontal.Magnitude < 0.5 then
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        return
    end
    local dir = horizontal.Unit

    local moved = (hrp.Position - walkLastPos).Magnitude
    if moved < 1.5 then walkStuckTimer = walkStuckTimer + 0.1 else walkStuckTimer = 0 end
    walkLastPos = hrp.Position

    if walkStuckTimer >= STUCK_TIME and not walkClimbing then
        walkClimbing = true
        walkClimbEndTime = now + CLIMB_DURATION
    end
    if walkClimbing and now >= walkClimbEndTime then
        walkClimbing = false; walkStuckTimer = 0
    end

    local probeDist = math.max(3, speed * 0.03)
    local blocked = obstacleAhead(hrp, dir, probeDist)
    local yVel = 0

    if walkClimbing then yVel = 40
    elseif blocked then
        yVel = 30
        local rightDir = Vector3.new(-dir.Z, 0, dir.X)
        if not obstacleAhead(hrp, rightDir, probeDist) then
            dir = (dir * 0.7 + rightDir * 0.3).Unit
        elseif not obstacleAhead(hrp, -rightDir, probeDist) then
            dir = (dir * 0.7 - rightDir * 0.3).Unit
        end
    else
        local groundY = groundBelow(hrp, 15)
        if groundY then
            local desiredY = groundY + 3
            local diff = desiredY - hrp.Position.Y
            yVel = math.clamp(diff * 8, -25, 25)
        end
    end
    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, yVel, dir.Z * speed)
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if not WalkRunning then
            if WalkPhase ~= "IDLE" then stopWalkMotion(); WalkPhase = "IDLE" end
            continue
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then task.wait(0.5); continue end
        if not HomePos or not TargetPos then
            setStatus("Set Home & Target first!", WARN); continue
        end

        if WalkPhase == "TO_TARGET" then
            local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z)
                - Vector3.new(TargetPos.X,0,TargetPos.Z)).Magnitude
            if dist < 8 then
                setStatus("Reached target! Going home...", SUCCESS)
                walkStuckTimer = 0; walkClimbing = false
                task.wait(0.5)
                WalkPhase = "TO_HOME"
            else
                walkMoveToward(hrp, TargetPos, WalkSpeed)
                setStatus(string.format("[Walk] → Target | %dm", math.floor(dist)), ACCENT2)
            end
        elseif WalkPhase == "TO_HOME" then
            local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z)
                - Vector3.new(HomePos.X,0,HomePos.Z)).Magnitude
            if dist < 8 then
                setStatus("Reached home! Going to target...", SUCCESS)
                walkStuckTimer = 0; walkClimbing = false
                task.wait(0.5)
                WalkPhase = "TO_TARGET"
            else
                walkMoveToward(hrp, HomePos, WalkSpeed)
                setStatus(string.format("[Walk] → Home | %dm", math.floor(dist)), SUCCESS)
            end
        end
    end
end)

