-- ========== NO CLIP LOGIC ==========
local function applyNoClip()
    if NoClipConn then NoClipConn:Disconnect() end
    NoClipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end

local function stopNoClip()
    if NoClipConn then NoClipConn:Disconnect(); NoClipConn = nil end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head") then
                part.CanCollide = true
            end
        end
    end
end

-- ========== HIDE ALL LOGIC ==========
function applyHide()
    SavedData = { parts = {}, decals = {}, guis = {}, effects = {}, lighting = {} }
    if HideOpts.Buildings then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not isCharacterPart(obj) then
                SavedData.parts[obj] = { Transparency = obj.Transparency, Reflectance = obj.Reflectance }
                obj.Transparency = 1; obj.Reflectance = 0
            end
        end
    end
    if HideOpts.NPCs then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isNPC(obj) then
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if not SavedData.parts[part] then SavedData.parts[part] = { Transparency = part.Transparency } end
                        part.Transparency = 1
                    end
                    if part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
                        SavedData.guis[part] = { Enabled = part.Enabled }; part.Enabled = false
                    end
                end
            end
        end
    end
    if HideOpts.Effects then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Highlight")) and not isCharacterPart(obj) then
                SavedData.effects[obj] = { Enabled = obj.Enabled }; obj.Enabled = false
            end
            if (obj:IsA("Decal") or obj:IsA("Texture")) and not isCharacterPart(obj) then
                SavedData.decals[obj] = { Transparency = obj.Transparency }; obj.Transparency = 1
            end
        end
    end
    if HideOpts.GUI then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")) and not isCharacterPart(obj) then
                if not SavedData.guis[obj] then SavedData.guis[obj] = { Enabled = obj.Enabled } end
                obj.Enabled = false
            end
        end
        local pg = playerGui()
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") and gui ~= Gui and gui.Name ~= "AllInOneUI" and gui.Enabled then
                SavedData.guis[gui] = { Enabled = true }; gui.Enabled = false
            end
        end
    end
    if HideOpts.Lighting then
        SavedData.lighting = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, ClockTime = Lighting.ClockTime }
        Lighting.Ambient = Color3.fromRGB(255,255,255); Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255); Lighting.Brightness = 2; Lighting.FogEnd = 100000; Lighting.FogStart = 0; Lighting.ClockTime = 12
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then SavedData.lighting.Sky = obj; obj.Parent = nil end
            if obj:IsA("Atmosphere") then SavedData.lighting.Atmosphere = { obj = obj, Density = obj.Density, Haze = obj.Haze }; obj.Density = 0; obj.Haze = 0 end
            if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") then
                SavedData.lighting[obj] = { Enabled = obj.Enabled }; obj.Enabled = false
            end
        end
    end
    setStatus("Visuals Hidden", SUCCESS)
end

function restoreAll()
    for obj, data in pairs(SavedData.parts) do pcall(function() if obj and obj.Parent then obj.Transparency = data.Transparency or 0; if data.Reflectance then obj.Reflectance = data.Reflectance end end end) end
    for obj, data in pairs(SavedData.decals) do pcall(function() if obj and obj.Parent then obj.Transparency = data.Transparency or 0 end end) end
    for obj, data in pairs(SavedData.guis) do pcall(function() if obj and obj.Parent then obj.Enabled = data.Enabled or true end end) end
    for obj, data in pairs(SavedData.effects) do pcall(function() if obj and obj.Parent then obj.Enabled = data.Enabled or true end end) end
    if SavedData.lighting and HideOpts.Lighting then
        local L = SavedData.lighting
        pcall(function()
            if L.Ambient then Lighting.Ambient = L.Ambient end; if L.OutdoorAmbient then Lighting.OutdoorAmbient = L.OutdoorAmbient end; if L.Brightness then Lighting.Brightness = L.Brightness end; if L.FogEnd then Lighting.FogEnd = L.FogEnd end; if L.FogStart then Lighting.FogStart = L.FogStart end; if L.ClockTime then Lighting.ClockTime = L.ClockTime end; if L.Sky then L.Sky.Parent = Lighting end
            if L.Atmosphere then L.Atmosphere.obj.Density = L.Atmosphere.Density; L.Atmosphere.obj.Haze = L.Atmosphere.Haze end
            for k, v in pairs(L) do if typeof(k) == "Instance" and v.Enabled ~= nil then pcall(function() k.Enabled = v.Enabled end) end end
        end)
    end
    SavedData = { parts = {}, decals = {}, guis = {}, effects = {}, lighting = {} }
end

local function startWatcher()
    if WatcherConn then WatcherConn:Disconnect() end
    WatcherConn = workspace.DescendantAdded:Connect(function(obj)
        if not HideActive then return end; task.wait(0.05)
        if not HideActive or not obj or not obj.Parent then return end
        if HideOpts.Buildings and obj:IsA("BasePart") and not isCharacterPart(obj) then SavedData.parts[obj] = { Transparency = obj.Transparency }; obj.Transparency = 1 end
        if HideOpts.Effects and (obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")) then SavedData.effects[obj] = { Enabled = obj.Enabled }; obj.Enabled = false end
        if HideOpts.GUI and (obj:IsA("BillboardGui") or obj:IsA("SurfaceGui")) then SavedData.guis[obj] = { Enabled = obj.Enabled }; obj.Enabled = false end
    end)
end

-- ========== AUTO WALK LOGIC ==========
local function stopWalkMotion()
    local hum = getHumanoid(); if hum then hum.WalkSpeed = 16 end
    local hrp = getHRP(); if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0,0,0) end
    climbing = false; stuckTimer = 0
end

local function obstacleAhead(hrp, dir, dist)
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { LocalPlayer.Character }; params.IgnoreWater = true
    local ray = workspace:Raycast(hrp.Position, dir.Unit * dist, params)
    if not ray or not ray.Instance or not ray.Instance.CanCollide or ray.Instance.Transparency >= 0.7 or ray.Instance.Size.Magnitude < 4 then return false end
    return true
end

local function groundBelow(hrp, maxDist)
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { LocalPlayer.Character }; params.IgnoreWater = true
    local ray = workspace:Raycast(hrp.Position, Vector3.new(0,-maxDist,0), params)
    return ray and ray.Position.Y or nil
end

local function moveToward(hrp, targetPos, speed)
    local now = os.clock()
    local horizontal = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    if horizontal.Magnitude < 0.5 then hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0); return end
    local dir = horizontal.Unit
    local moved = (hrp.Position - lastPos).Magnitude
    if moved < 1.5 then stuckTimer = stuckTimer + 0.1 else stuckTimer = 0 end
    lastPos = hrp.Position
    if stuckTimer >= STUCK_TIME and not climbing then climbing = true; climbEndTime = now + CLIMB_DURATION end
    if climbing and now >= climbEndTime then climbing = false; stuckTimer = 0 end

    local probeDist = math.max(3, speed * 0.03)
    local blocked = obstacleAhead(hrp, dir, probeDist)
    local yVel = 0
    if climbing then yVel = 40
    elseif blocked then
        yVel = 30; local rightDir = Vector3.new(-dir.Z, 0, dir.X)
        if not obstacleAhead(hrp, rightDir, probeDist) then dir = (dir * 0.7 + rightDir * 0.3).Unit
        elseif not obstacleAhead(hrp, -rightDir, probeDist) then dir = (dir * 0.7 - rightDir * 0.3).Unit end
    else
        local groundY = groundBelow(hrp, 15)
        if groundY then yVel = math.clamp((groundY + 3 - hrp.Position.Y) * 8, -25, 25) end
    end
    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, yVel, dir.Z * speed)
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if not WalkRunning then if WalkPhase ~= "IDLE" then stopWalkMotion(); WalkPhase = "IDLE" end continue end
        local hrp, hum = getHRP(), getHumanoid()
        if not hrp or not hum or hum.Health <= 0 then task.wait(0.5); continue end
        if not HomePos or not TargetPos then setStatus("Set P1 & P2 first!", WARN); continue end

        if WalkPhase == "TO_TARGET" then
            local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z) - Vector3.new(TargetPos.X,0,TargetPos.Z)).Magnitude
            if dist < 8 then stuckTimer = 0; climbing = false; task.wait(0.5); WalkPhase = "TO_HOME"
            else moveToward(hrp, TargetPos, WalkSpeed); setStatus(string.format("→ P2 | %dm", math.floor(dist)), ACCENT2) end
        elseif WalkPhase == "TO_HOME" then
            local dist = (Vector3.new(hrp.Position.X,0,hrp.Position.Z) - Vector3.new(HomePos.X,0,HomePos.Z)).Magnitude
            if dist < 8 then stuckTimer = 0; climbing = false; task.wait(0.5); WalkPhase = "TO_TARGET"
            else moveToward(hrp, HomePos, WalkSpeed); setStatus(string.format("→ P1 | %dm", math.floor(dist)), SUCCESS) end
        end
    end
end)

